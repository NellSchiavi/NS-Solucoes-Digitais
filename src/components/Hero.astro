---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { buildWhatsAppLink } from '../lib/whatsapp';
import { withBase } from '../lib/url';
import { getFeaturedDemo } from '../lib/projects';

const demo = await getFeaturedDemo();

const highlights = [
  'Atendimento direto com o desenvolvedor',
  'Soluções personalizadas, sem modelo pronto',
  'Acompanhamento próximo do projeto',
];
---

<section class="relative overflow-hidden" aria-labelledby="hero-title">
  <!-- Acentos geométricos de fundo (decorativos) -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="ns-grid absolute inset-0"></div>
    <div class="absolute inset-0 bg-[radial-gradient(1100px_600px_at_15%_-10%,rgb(var(--brand-rgb)/0.07),transparent_60%)]"></div>
    <div class="absolute -right-40 top-0 h-[140%] w-[45%] -skew-x-12 bg-gradient-to-b from-[var(--color-brand-900)]/20 via-transparent to-transparent"></div>
    <div class="absolute right-[8%] top-24 h-40 w-40 -skew-x-12 border border-[var(--color-brand-500)]/20"></div>
    <div class="ns-diagonal absolute -left-10 bottom-0 hidden h-48 w-48 opacity-60 lg:block"></div>
  </div>

  <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-14 px-5 pb-20 pt-14 sm:px-8 sm:pb-28 sm:pt-24 lg:grid-cols-[1.15fr_1fr] lg:gap-10">
    <!-- Coluna de texto -->
    <div>
      <span class="inline-flex items-center gap-2 rounded-full bg-[var(--color-surface)] px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-brand-400)] ring-1 ring-[var(--color-border-strong)]">
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-brand-500)]" aria-hidden="true"></span>
        NS Soluções Digitais
      </span>

      <h1 id="hero-title" class="mt-6 font-[var(--font-display)] text-[2.15rem] font-bold uppercase leading-[1.05] tracking-tight text-white sm:text-5xl xl:text-[3.5rem]">
        Sua ideia em um site{" "}
        <br class="hidden sm:block" />
        <span class="text-[var(--color-brand-400)]">de verdade</span>.
      </h1>

      <p class="mt-6 text-xl font-semibold leading-snug text-white sm:text-2xl">
        Sites e soluções digitais personalizados para empresas.
      </p>

      <p class="mt-4 max-w-xl text-base leading-relaxed text-[var(--color-ink-muted)] sm:text-lg">
        Do site institucional ao sistema de gestão, a NS planeja, desenvolve e
        acompanha cada projeto, com atendimento direto com o desenvolvedor
        responsável.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4">
        <Button href={buildWhatsAppLink()} target="_blank" variant="primary" size="lg" icon="whatsapp" class="w-full sm:w-auto">
          Solicitar orçamento
          {' '}<span class="sr-only">pelo WhatsApp (abre em nova aba)</span>
        </Button>
        <Button href={withBase('/#portfolio')} variant="secondary" size="lg" icon="arrow-right" class="w-full sm:w-auto">
          Conhecer projetos
        </Button>
      </div>

      <ul class="mt-12 flex flex-col gap-3 border-t border-[var(--color-border)] pt-7 sm:flex-row sm:flex-wrap sm:gap-x-8">
        {highlights.map((item) => (
          <li class="flex items-center gap-2 text-sm text-[var(--color-ink-muted)]">
            <Icon name="check" class="h-4 w-4 shrink-0 text-[var(--color-brand-500)]" />
            {item}
          </li>
        ))}
      </ul>
    </div>

    <!--
      Composição visual: interface estilizada (ilustrativa, sem dados).
      No desktop fica ancorada no topo com margem fixa (lg:self-start), em vez
      de centralizada: assim não "pula" quando as fontes terminam de carregar
      e mudam a altura do texto ao lado (evita layout shift / CLS).
    -->
    <div class="relative lg:mt-36 lg:self-start" aria-hidden={demo ? undefined : 'true'}>
      <div class="absolute -inset-6 -z-10 rounded-[28px] bg-[radial-gradient(260px_260px_at_75%_15%,rgb(var(--brand-rgb)/0.16),transparent_65%)]" aria-hidden="true"></div>

      <div class="overflow-hidden rounded-2xl border border-[var(--color-border-strong)] bg-[var(--color-bg-soft)] shadow-[0_30px_80px_-30px_rgba(0,0,0,0.7)]" aria-hidden="true">
        <!-- barra de janela -->
        <div class="flex items-center gap-2 border-b border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-3">
          <span class="h-2.5 w-2.5 rounded-full bg-[var(--color-border-strong)]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[var(--color-border-strong)]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[var(--color-border-strong)]"></span>
          <div class="ml-3 h-6 flex-1 rounded-md bg-[var(--color-bg)]/70"></div>
        </div>

        <!-- mini painel ilustrativo: menu lateral + indicadores + gráfico -->
        <div class="grid grid-cols-[3.25rem_1fr] sm:grid-cols-[4.5rem_1fr]">
          <div class="space-y-3 border-r border-[var(--color-border)] p-3 sm:p-4">
            <span class="block h-5 w-5 rounded bg-[var(--color-brand-500)]"></span>
            <span class="block h-1.5 w-full rounded-full bg-white/25"></span>
            <span class="block h-1.5 w-4/5 rounded-full bg-white/15"></span>
            <span class="block h-1.5 w-full rounded-full bg-white/15"></span>
            <span class="block h-1.5 w-3/5 rounded-full bg-white/15"></span>
          </div>
          <div class="space-y-5 p-5 sm:p-6">
            <div class="space-y-2.5">
              <div class="h-3.5 w-3/5 rounded-full bg-white/85"></div>
              <div class="h-2.5 w-2/5 rounded-full bg-white/25"></div>
            </div>
            <div class="grid grid-cols-3 gap-3">
              <div class="h-14 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-2.5">
                <div class="h-1.5 w-2/3 rounded-full bg-white/25"></div>
                <div class="mt-2 h-3 w-1/2 rounded-full bg-white/70"></div>
              </div>
              <div class="h-14 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-2.5">
                <div class="h-1.5 w-2/3 rounded-full bg-white/25"></div>
                <div class="mt-2 h-3 w-1/3 rounded-full bg-white/70"></div>
              </div>
              <div class="h-14 rounded-lg border border-[var(--color-brand-500)]/50 bg-[var(--color-brand-900)]/60 p-2.5">
                <div class="h-1.5 w-2/3 rounded-full bg-[var(--color-brand-400)]/60"></div>
                <div class="mt-2 h-3 w-1/2 rounded-full bg-[var(--color-brand-400)]"></div>
              </div>
            </div>
            <div class="flex h-20 items-end gap-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-3">
              {[40, 65, 45, 80, 60, 95, 70].map((h, i) => (
                <span
                  class:list={['flex-1 rounded-sm', i === 5 ? 'bg-[var(--color-brand-500)]' : 'bg-white/15']}
                  style={`height: ${h}%`}
                ></span>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Destaque da demonstração pública (dados do conteúdo do projeto) -->
      {demo && (
        <a
          href={demo.data.demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative mt-4 flex items-center gap-3 rounded-xl border border-[var(--color-brand-500)]/40 bg-[var(--color-bg-soft)] p-4 shadow-[0_20px_50px_-20px_rgba(0,0,0,0.8)] transition-colors hover:border-[var(--color-brand-500)] sm:absolute sm:-bottom-8 sm:-left-6 sm:mt-0 sm:w-72"
        >
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--color-brand-500)]/15 text-[var(--color-brand-400)]" aria-hidden="true">
            <Icon name="external" class="h-4 w-4" />
          </span>
          <span class="min-w-0">
            <span class="block text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-[var(--color-brand-400)]">
              Demonstração disponível
            </span>
            <span class="mt-0.5 block text-sm font-semibold text-white">
              Experimente o {demo.data.name}
            </span>
            {' '}<span class="sr-only">(abre em nova aba)</span>
          </span>
          <Icon name="arrow-right" class="ml-auto h-4 w-4 shrink-0 text-[var(--color-ink-muted)] transition-transform group-hover:translate-x-0.5 group-hover:text-[var(--color-brand-400)]" />
        </a>
      )}
    </div>
  </div>
</section>
