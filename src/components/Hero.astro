---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { buildWhatsAppLink } from '../lib/whatsapp';
---

<section class="relative overflow-hidden" aria-label="Apresentação">
  <!-- Acentos geométricos de fundo -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0 bg-[radial-gradient(1100px_600px_at_15%_-10%,rgb(var(--brand-rgb)/0.06),transparent_60%)]"></div>
    <div class="absolute -right-40 top-0 h-[140%] w-[45%] -skew-x-12 bg-gradient-to-b from-[var(--color-brand-900)]/18 via-transparent to-transparent"></div>
    <div class="absolute right-[8%] top-24 h-40 w-40 -skew-x-12 border border-[var(--color-brand-500)]/20"></div>
  </div>

  <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-14 px-5 pb-20 pt-16 sm:px-8 sm:pb-28 sm:pt-24 lg:grid-cols-[1.15fr_1fr] lg:gap-10">
    <!-- Coluna de texto -->
    <div>
      <span class="inline-flex items-center gap-2 rounded-full bg-[var(--color-surface)] px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-brand-400)] ring-1 ring-[var(--color-border-strong)]">
        Soluções digitais sob medida
      </span>

      <h1 class="mt-6 font-[var(--font-display)] text-4xl font-bold leading-[1.08] tracking-tight text-white sm:text-5xl lg:text-6xl">
        Sua ideia, transformada
        <br class="hidden sm:block" />
        em um <span class="text-[var(--color-brand-400)]">produto digital de verdade</span>.
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-[var(--color-ink-muted)]">
        Desenvolvo sites institucionais, landing pages, sistemas web e apps
        personalizados para o seu negócio — do planejamento ao lançamento,
        com atendimento direto comigo em todas as etapas.
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-4">
        <Button href={buildWhatsAppLink()} target="_blank" variant="primary" size="lg" icon="whatsapp">
          Solicitar orçamento
        </Button>
        <Button href="#portfolio" variant="secondary" size="lg" icon="arrow-right">
          Ver portfólio
        </Button>
      </div>

      <div class="mt-12 flex flex-wrap gap-x-8 gap-y-3 border-t border-[var(--color-border)] pt-7">
        {[
          'Projetos feitos do zero, sem modelo pronto',
          'Cases reais no portfólio',
          'Orçamento direto pelo WhatsApp',
        ].map((item) => (
          <div class="flex items-center gap-2 text-sm text-[var(--color-ink-muted)]">
            <Icon name="check" class="h-4 w-4 shrink-0 text-[var(--color-brand-500)]" />
            {item}
          </div>
        ))}
      </div>
    </div>

    <!-- Composição visual: interface estilizada, não literal -->
    <div class="relative">
      <div class="absolute -inset-6 -z-10 rounded-[28px] bg-[radial-gradient(260px_260px_at_75%_15%,rgb(var(--brand-rgb)/0.16),transparent_65%)]"></div>

      <div class="overflow-hidden rounded-2xl border border-[var(--color-border-strong)] bg-[var(--color-bg-soft)] shadow-[0_30px_80px_-30px_rgba(0,0,0,0.7)]">
        <!-- barra de janela -->
        <div class="flex items-center gap-2 border-b border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-3">
          <span class="h-2.5 w-2.5 rounded-full bg-[var(--color-border-strong)]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[var(--color-border-strong)]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[var(--color-border-strong)]"></span>
          <div class="ml-3 h-6 flex-1 rounded-md bg-[var(--color-bg)]/70"></div>
        </div>

        <!-- mini "site" ilustrativo -->
        <div class="space-y-5 p-6">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-1.5">
              <span class="h-4 w-4 rounded bg-[var(--color-brand-500)]"></span>
              <span class="h-2 w-14 rounded-full bg-white/70"></span>
            </div>
            <span class="h-6 w-20 rounded-full bg-[var(--color-brand-500)]/90"></span>
          </div>

          <div class="space-y-2.5">
            <div class="h-3.5 w-4/5 rounded-full bg-white/85"></div>
            <div class="h-3.5 w-3/5 rounded-full bg-[var(--color-brand-400)]"></div>
            <div class="h-2.5 w-2/3 rounded-full bg-white/25"></div>
          </div>

          <div class="grid grid-cols-3 gap-3 pt-2">
            <div class="h-16 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)]"></div>
            <div class="h-16 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)]"></div>
            <div class="h-16 rounded-lg border border-[var(--color-brand-500)]/50 bg-[var(--color-brand-900)]/60"></div>
          </div>
        </div>
      </div>

      <!-- card flutuante -->
      <div class="absolute -bottom-6 -left-6 hidden w-52 rounded-xl border border-[var(--color-border-strong)] bg-[var(--color-bg-soft)] p-4 shadow-[0_20px_50px_-20px_rgba(0,0,0,0.8)] sm:block">
        <div class="flex items-center gap-2">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-[var(--color-brand-500)]/15 text-[var(--color-brand-400)]">
            <Icon name="check" class="h-4 w-4" />
          </span>
          <p class="text-xs font-semibold text-white">Feito sob medida para o seu negócio</p>
        </div>
      </div>
    </div>
  </div>
</section>
