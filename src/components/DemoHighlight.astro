---
/**
 * Faixa de destaque da demonstração pública (hoje: Escala do Louvor).
 * Todo o conteúdo vem do arquivo do projeto (demoUrl, problem, demoNotes,
 * whatsappMessage): sem demonstração cadastrada, a seção não é renderizada.
 */
import Button from './Button.astro';
import Icon from './Icon.astro';
import { getFeaturedDemo, getWhatsAppMessage } from '../lib/projects';
import { buildWhatsAppLink } from '../lib/whatsapp';
import { withBase } from '../lib/url';

const demo = await getFeaturedDemo();
---

{demo && demo.data.demoUrl && (
  <section class="relative scroll-mt-20 border-t border-[var(--color-border)] py-20 sm:py-24" aria-labelledby="demo-title">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="relative overflow-hidden rounded-3xl border border-[var(--color-brand-500)]/30 bg-[var(--color-surface)]">
        <div class="pointer-events-none absolute inset-0" aria-hidden="true">
          <div class="absolute inset-0 bg-[radial-gradient(700px_320px_at_0%_0%,rgb(var(--brand-rgb)/0.10),transparent_65%)]"></div>
          <div class="absolute -right-16 -top-16 h-56 w-56 -skew-x-12 border border-[var(--color-brand-500)]/15"></div>
        </div>

        <div class="relative grid grid-cols-1 gap-10 p-6 sm:p-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14 lg:p-14">
          <div>
            <span class="ns-eyebrow">Demonstração disponível</span>
            <h2 id="demo-title" class="mt-3 font-[var(--font-display)] text-3xl font-bold tracking-tight text-white sm:text-4xl">
              Experimente o {demo.data.name}
            </h2>
            <p class="mt-4 text-base leading-relaxed text-[var(--color-ink-muted)]">
              {demo.data.shortDescription}
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
              <Button href={demo.data.demoUrl} target="_blank" variant="primary" size="lg" icon="external" class="w-full sm:w-auto">
                Acessar demonstração
                {' '}<span class="sr-only">(abre em nova aba)</span>
              </Button>
              <Button href={withBase(`/portfolio/${demo.id}/`)} variant="secondary" size="lg" icon="arrow-right" class="w-full sm:w-auto">
                Ver case completo
              </Button>
            </div>
            <a
              href={buildWhatsAppLink(getWhatsAppMessage(demo.data))}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-white transition-colors hover:text-[var(--color-brand-400)]"
            >
              <Icon name="whatsapp" class="h-4 w-4 text-[var(--color-brand-500)]" />
              Quero uma solução assim
              {' '}<span class="sr-only">pelo WhatsApp (abre em nova aba)</span>
            </a>
          </div>

          {demo.data.demoNotes.length > 0 && (
            <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-soft)] p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-ink-faint)]">
                Como experimentar
              </p>
              <ul class="mt-4 space-y-3">
                {demo.data.demoNotes.map((note) => (
                  <li class="flex gap-2.5 text-sm leading-relaxed text-[var(--color-ink-muted)]">
                    <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-[var(--color-brand-500)]" />
                    {note}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
)}
