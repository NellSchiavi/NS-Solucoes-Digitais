---
import Logo from './Logo.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { buildWhatsAppLink } from '../lib/whatsapp';
import { withBase } from '../lib/url';

// Âncoras sempre com o caminho da Home: assim o menu também funciona
// nas páginas de case (/portfolio/...), e não só na própria Home.
const navItems = [
  { href: withBase('/#servicos'), label: 'Serviços' },
  { href: withBase('/#portfolio'), label: 'Projetos' },
  { href: withBase('/#sobre'), label: 'Sobre' },
  { href: withBase('/#contato'), label: 'Contato' },
];
const whatsAppLink = buildWhatsAppLink();
---

<header class="sticky top-0 z-50 border-b border-[var(--color-border)]/80 bg-[var(--color-bg)]/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3.5 sm:px-8">
    <Logo />

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Navegação principal">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-sm font-medium text-[var(--color-ink-muted)] transition-colors hover:text-white"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <div class="hidden sm:block">
        <Button href={whatsAppLink} target="_blank" variant="primary" size="md" icon="whatsapp">
          Solicitar orçamento
          {' '}<span class="sr-only">pelo WhatsApp (abre em nova aba)</span>
        </Button>
      </div>

      <button
        id="menu-toggle"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-white ring-1 ring-[var(--color-border-strong)] lg:hidden"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span data-icon="open"><Icon name="menu" class="h-5 w-5" /></span>
        <span data-icon="close" class="hidden"><Icon name="close" class="h-5 w-5" /></span>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t border-[var(--color-border)] bg-[var(--color-bg-soft)] px-5 py-4 lg:hidden"
    aria-label="Navegação principal (celular)"
  >
    {navItems.map((item) => (
      <a
        href={item.href}
        class="rounded-lg px-3 py-2.5 text-sm font-medium text-[var(--color-ink-muted)] hover:bg-[var(--color-surface)] hover:text-white"
      >
        {item.label}
      </a>
    ))}
    <Button href={whatsAppLink} target="_blank" variant="primary" size="md" icon="whatsapp" class="mt-3 w-full sm:hidden">
      Solicitar orçamento
      {' '}<span class="sr-only">pelo WhatsApp (abre em nova aba)</span>
    </Button>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      menu.classList.toggle('flex', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
      toggle.querySelector('[data-icon="open"]')?.classList.toggle('hidden', open);
      toggle.querySelector('[data-icon="close"]')?.classList.toggle('hidden', !open);
    };

    toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.classList.contains('hidden')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
