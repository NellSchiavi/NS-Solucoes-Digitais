---
import Logo from './Logo.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import ThemeSwitcher from './ThemeSwitcher.astro';
import { buildWhatsAppLink } from '../lib/whatsapp';

const navItems = [
  { href: '#servicos', label: 'Serviços' },
  { href: '#portfolio', label: 'Portfólio' },
  { href: '#sobre', label: 'Sobre' },
  { href: '#contato', label: 'Contato' },
];
---

<header class="sticky top-0 z-50 border-b border-[var(--color-border)]/80 bg-[var(--color-bg)]/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3.5 sm:px-8">
    <Logo />

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Navegação principal">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-sm font-medium text-[var(--color-ink-muted)] transition-colors hover:text-white"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3 lg:gap-4">
      <ThemeSwitcher />

      <div class="hidden lg:block">
        <Button href={buildWhatsAppLink()} target="_blank" variant="primary" size="md">
          Solicitar orçamento
        </Button>
      </div>

      <button
        id="menu-toggle"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-white ring-1 ring-[var(--color-border-strong)] lg:hidden"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" class="h-5 w-5" />
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t border-[var(--color-border)] bg-[var(--color-bg-soft)] px-5 py-4 lg:hidden"
  >
    {navItems.map((item) => (
      <a
        href={item.href}
        class="rounded-lg px-3 py-2.5 text-sm font-medium text-[var(--color-ink-muted)] hover:bg-[var(--color-surface)] hover:text-white"
      >
        {item.label}
      </a>
    ))}
    <Button href={buildWhatsAppLink()} target="_blank" variant="primary" size="md" class="mt-3 w-full">
      Solicitar orçamento
    </Button>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.contains('flex');
      menu.classList.toggle('hidden', isOpen);
      menu.classList.toggle('flex', !isOpen);
      toggle.setAttribute('aria-expanded', String(!isOpen));
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        menu.classList.remove('flex');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
