---
/**
 * Ícones inline (sem dependência externa) — traço fino, no espírito
 * outline/geométrico da referência visual.
 */
interface Props {
  name:
    | 'monitor'
    | 'layers'
    | 'devices'
    | 'sliders'
    | 'puzzle'
    | 'whatsapp'
    | 'arrow-right'
    | 'check'
    | 'menu'
    | 'close'
    | 'chevron-right'
    | 'palette';
  class?: string;
}

const { name, class: className = 'h-6 w-6' } = Astro.props;
---

{name === 'monitor' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class={className} aria-hidden="true">
    <rect x="3" y="4" width="18" height="12" rx="2" />
    <path d="M8 20h8M12 16v4" stroke-linecap="round" />
  </svg>
)}

{name === 'layers' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class={className} aria-hidden="true">
    <path d="M12 3l9 5-9 5-9-5 9-5z" stroke-linejoin="round" />
    <path d="M3 13l9 5 9-5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}

{name === 'devices' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class={className} aria-hidden="true">
    <rect x="3" y="5" width="13" height="9" rx="1.5" />
    <rect x="17" y="9" width="4" height="10" rx="1" />
    <path d="M7 18h8" stroke-linecap="round" />
  </svg>
)}

{name === 'sliders' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class={className} aria-hidden="true">
    <path d="M4 6h10M18 6h2M4 12h2M8 12h12M4 18h14M20 18h0" stroke-linecap="round" />
    <circle cx="16" cy="6" r="2" />
    <circle cx="6" cy="12" r="2" />
    <circle cx="18" cy="18" r="2" />
  </svg>
)}

{name === 'puzzle' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class={className} aria-hidden="true">
    <path d="M9 4h4a1 1 0 011 1v2.2a1.8 1.8 0 100 3.6V13a1 1 0 01-1 1h-2.2a1.8 1.8 0 10-3.6 0H5a1 1 0 01-1-1V9a1 1 0 011-1h2.2a1.8 1.8 0 100-3.6V4a1 1 0 011-1z" stroke-linejoin="round" />
  </svg>
)}

{name === 'whatsapp' && (
  <svg viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.87.5 3.62 1.44 5.13L2 22l5.13-1.55a9.83 9.83 0 004.91 1.32h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2zm0 18.06h-.01a8.14 8.14 0 01-4.15-1.14l-.3-.18-3.05.92.92-2.98-.19-.31a8.14 8.14 0 01-1.25-4.36c0-4.51 3.67-8.18 8.19-8.18 2.19 0 4.24.85 5.79 2.4a8.13 8.13 0 012.4 5.79c0 4.52-3.68 8.19-8.19 8.19h.01zm4.49-6.14c-.25-.12-1.45-.72-1.67-.8-.22-.08-.39-.12-.55.12-.16.25-.63.8-.78.96-.14.16-.29.18-.53.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.48-1.39-1.73-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.16.04-.31-.02-.43-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.42-.55-.42h-.47c-.16 0-.43.06-.65.31s-.86.84-.86 2.05.88 2.38 1 2.55c.12.16 1.73 2.64 4.19 3.7.59.25 1.04.4 1.4.52.59.19 1.12.16 1.54.1.47-.07 1.45-.59 1.65-1.17.21-.57.21-1.06.14-1.17-.06-.1-.22-.16-.47-.28z" />
  </svg>
)}

{name === 'arrow-right' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class={className} aria-hidden="true">
    <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}

{name === 'check' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class={className} aria-hidden="true">
    <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}

{name === 'menu' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class={className} aria-hidden="true">
    <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
  </svg>
)}

{name === 'close' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class={className} aria-hidden="true">
    <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
  </svg>
)}

{name === 'chevron-right' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class={className} aria-hidden="true">
    <path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}

{name === 'palette' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class={className} aria-hidden="true">
    <path d="M12 3a9 9 0 100 18c1.1 0 1.8-.9 1.8-1.9 0-.5-.2-.9-.5-1.3-.3-.3-.5-.8-.5-1.3 0-1 .8-1.8 1.8-1.8H17a4 4 0 004-4C21 6.5 17 3 12 3z" stroke-linejoin="round" />
    <circle cx="7.5" cy="11" r="1" fill="currentColor" stroke="none" />
    <circle cx="10" cy="7.5" r="1" fill="currentColor" stroke="none" />
    <circle cx="14.5" cy="7.5" r="1" fill="currentColor" stroke="none" />
  </svg>
)}
