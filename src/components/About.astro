---
/**
 * Sobre a NS — só fatos confirmados: marca, forma de atendimento e as
 * tecnologias efetivamente usadas nos projetos do portfólio (lidas da
 * coleção `projects`, nunca digitadas à mão). Sem anos de experiência,
 * número de clientes, certificações ou resultados não confirmados.
 */
import { getPortfolioProjects } from '../lib/projects';

const projects = await getPortfolioProjects();
const technologies = [...new Set(projects.flatMap((p) => p.data.technologies))];
---

<section id="sobre" class="scroll-mt-20 border-t border-[var(--color-border)] py-20 sm:py-28" aria-labelledby="sobre-title">
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-5 sm:px-8 lg:grid-cols-[1.2fr_0.8fr] lg:gap-16">
    <div class="max-w-2xl">
      <span class="ns-eyebrow">Sobre a NS</span>
      <h2 id="sobre-title" class="mt-3 font-[var(--font-display)] text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Tecnologia sob medida, com atendimento direto
      </h2>
      <div class="mt-6 space-y-4 text-base leading-relaxed text-[var(--color-ink-muted)]">
        <p>
          A NS | Nelson Schiavi Soluções Digitais desenvolve sites e sistemas
          web personalizados para empresas e profissionais, do planejamento
          ao lançamento.
        </p>
        <p>
          Cada projeto começa pelo entendimento da necessidade real do
          negócio, para então definir a solução técnica adequada, e não um
          modelo pronto adaptado depois.
        </p>
        <p>
          O atendimento é feito diretamente com o desenvolvedor responsável,{' '}
          <strong class="font-semibold text-white">Nelson Schiavi</strong>: quem
          entende o seu pedido é quem constrói a solução.
        </p>
      </div>
    </div>

    {technologies.length > 0 && (
      <div class="flex flex-col justify-center rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-7">
        <h3 class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-ink-faint)]">
          Tecnologias usadas nos projetos
        </h3>
        <ul class="mt-5 flex flex-wrap gap-2">
          {technologies.map((tech) => (
            <li class="rounded-full border border-[var(--color-border-strong)] px-3 py-1 text-xs font-medium text-[var(--color-ink-muted)]">
              {tech}
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>
