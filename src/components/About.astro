---
/**
 * Sobre a NS — texto curto e neutro, baseado apenas em fatos confirmados
 * (marca, serviços oferecidos). Sem anos de experiência, número de
 * clientes, certificações ou resultados — nada disso foi confirmado,
 * então não aparece aqui. Pode ser refinado depois com mais texto
 * pessoal do Nelson.
 */
const focusAreas = [
  'Sites institucionais',
  'Landing pages',
  'Sistemas Web',
  'Apps personalizados',
  'Soluções sob medida',
];
---

<section id="sobre" class="scroll-mt-20 border-t border-[var(--color-border)] py-20 sm:py-28" aria-label="Sobre a NS">
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-5 sm:px-8 lg:grid-cols-[1.2fr_0.8fr] lg:gap-16">
    <div class="max-w-2xl">
      <span class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-brand-400)]">
        Sobre
      </span>
      <h2 class="mt-3 font-[var(--font-display)] text-3xl font-bold tracking-tight text-white sm:text-4xl">
        NS | Nelson Schiavi Soluções Digitais
      </h2>

      <div class="mt-6 space-y-4 text-base leading-relaxed text-[var(--color-ink-muted)]">
        <p>
          Sou Nelson Schiavi, responsável pela NS | Nelson Schiavi Soluções
          Digitais. Desenvolvo sites institucionais, landing pages, apps e
          sistemas web sob medida — do planejamento ao lançamento.
        </p>
        <p>
          O ponto de partida de cada projeto é entender a necessidade real
          do negócio, para então construir uma solução digital pensada
          especificamente para esse contexto — não um modelo pronto
          adaptado depois.
        </p>
      </div>
    </div>

    <div class="flex flex-col justify-center rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-7">
      <h3 class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-ink-faint)]">
        Áreas de atuação
      </h3>
      <ul class="mt-4 space-y-3">
        {focusAreas.map((area) => (
          <li class="flex items-center gap-2.5 text-sm font-medium text-white">
            <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-brand-500)]"></span>
            {area}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
