---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { buildWhatsAppLink, PHONE_DISPLAY } from '../lib/whatsapp';
import { withBase } from '../lib/url';
import { getFeaturedDemo } from '../lib/projects';

const year = new Date().getFullYear();
const demo = await getFeaturedDemo();

const navItems = [
  { href: withBase('/#servicos'), label: 'Serviços' },
  { href: withBase('/#portfolio'), label: 'Projetos' },
  { href: withBase('/#sobre'), label: 'Sobre a NS' },
  { href: withBase('/contato/'), label: 'Contato' },
];
---

<footer id="contato" class="relative scroll-mt-20 overflow-hidden border-t border-[var(--color-border)] bg-[var(--color-bg-soft)]">
  <div class="ns-diagonal pointer-events-none absolute -right-10 top-0 hidden h-full w-64 opacity-40 md:block" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-5 py-16 sm:px-8">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_0.8fr_1fr]">
      <div class="max-w-sm sm:col-span-2 lg:col-span-1">
        <Logo />
        <p class="mt-4 text-sm font-semibold uppercase tracking-wide text-white">
          Sua ideia em um site de verdade.
        </p>
        <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)]">
          Sites e soluções digitais personalizados para empresas, com
          atendimento direto com o desenvolvedor.
        </p>
      </div>

      <nav aria-label="Rodapé">
        <h3 class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-ink-faint)]">
          Navegação
        </h3>
        <ul class="mt-3 space-y-2.5">
          {navItems.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-[var(--color-ink-muted)] transition-colors hover:text-white">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-ink-faint)]">
          Fale com a NS
        </h3>
        <a
          href={buildWhatsAppLink()}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex items-center gap-2 text-sm font-medium text-white hover:text-[var(--color-brand-400)]"
        >
          <Icon name="whatsapp" class="h-4 w-4 text-[var(--color-brand-500)]" />
          WhatsApp {PHONE_DISPLAY}
          {' '}<span class="sr-only">(abre em nova aba)</span>
        </a>

        {demo && demo.data.demoUrl && (
          <a
            href={demo.data.demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 flex items-center gap-2 text-sm text-[var(--color-ink-muted)] hover:text-white"
          >
            <Icon name="external" class="h-4 w-4 text-[var(--color-brand-500)]" />
            Demonstração: {demo.data.name}
            {' '}<span class="sr-only">(abre em nova aba)</span>
          </a>
        )}
      </div>
    </div>

    <div class="mt-12 border-t border-[var(--color-border)] pt-6 text-xs text-[var(--color-ink-faint)]">
      <p>© {year} NS | Nelson Schiavi Soluções Digitais. Todos os direitos reservados.</p>
    </div>
  </div>
</footer>
