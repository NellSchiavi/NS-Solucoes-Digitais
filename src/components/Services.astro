---
/**
 * Serviços da NS. Cada serviço aponta para os cases reais que o
 * comprovam (slugs da coleção `projects`); serviços sem case publicado
 * não recebem link, em vez de associar um projeto que não o demonstra.
 * Nenhuma condição comercial (prazo, preço, plano) é prometida aqui.
 */
import Icon from './Icon.astro';
import { getPortfolioProjects, getShortName } from '../lib/projects';
import { buildWhatsAppLink, WHATSAPP_MESSAGES } from '../lib/whatsapp';
import { SERVICES as services } from '../lib/services';
import { withBase } from '../lib/url';


// Nome curto de cada case para os links.
const projects = await getPortfolioProjects();
const caseNames = new Map(projects.map((p) => [p.id, getShortName(p.data.name)]));
---

<section id="servicos" class="relative scroll-mt-20 border-t border-[var(--color-border)] py-20 sm:py-28" aria-labelledby="servicos-title">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="max-w-2xl">
      <span class="ns-eyebrow">Serviços</span>
      <h2 id="servicos-title" class="mt-3 font-[var(--font-display)] text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Do site ao sistema de gestão
      </h2>
      <p class="mt-4 text-base leading-relaxed text-[var(--color-ink-muted)]">
        Soluções digitais desenvolvidas sob medida para a necessidade de cada
        empresa. Sempre que possível, veja o serviço aplicado em um projeto real.
      </p>
    </div>

    <ul class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => {
        const cases = service.cases.filter((slug) => caseNames.has(slug));
        return (
          <li class="group relative flex flex-col overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 transition-colors hover:border-[var(--color-brand-500)]/50 sm:p-7">
            <div class="pointer-events-none absolute -right-8 -top-8 h-20 w-20 -skew-x-12 border border-[var(--color-brand-500)]/0 transition-colors group-hover:border-[var(--color-brand-500)]/25" aria-hidden="true"></div>
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-[var(--color-brand-500)]/12 text-[var(--color-brand-400)]">
              <Icon name={service.icon} class="h-5 w-5" />
            </div>
            <h3 class="mt-5 text-lg font-semibold text-white">{service.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--color-ink-muted)]">
              {service.description}
            </p>

            {cases.length > 0 && (
              <p class="mt-4 text-xs text-[var(--color-ink-faint)]">
                Na prática:{' '}
                {cases.map((slug, index) => (
                  <>
                    {index > 0 && ' · '}
                    <a
                      href={withBase(`/portfolio/${slug}/`)}
                      class="font-medium text-[var(--color-ink-muted)] underline decoration-[var(--color-border-strong)] underline-offset-4 hover:text-[var(--color-brand-400)] hover:decoration-[var(--color-brand-500)]"
                    >
                      {caseNames.get(slug)}
                    </a>
                  </>
                ))}
              </p>
            )}

            <a
              href={buildWhatsAppLink(WHATSAPP_MESSAGES[service.topic])}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-5 inline-flex items-center gap-1.5 self-start text-sm font-semibold text-white transition-colors hover:text-[var(--color-brand-400)]"
            >
              <Icon name="whatsapp" class="h-4 w-4 text-[var(--color-brand-500)]" />
              Falar sobre este serviço
              {' '}<span class="sr-only">: {service.title}, pelo WhatsApp (abre em nova aba)</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>
