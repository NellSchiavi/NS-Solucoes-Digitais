---
import Icon from './Icon.astro';
import { buildWhatsAppLink } from '../lib/whatsapp';

const services = [
  {
    icon: 'monitor' as const,
    title: 'Sites institucionais',
    audience: 'Para negócios e profissionais',
    description:
      'Presença digital profissional que apresenta sua empresa, seus serviços e fortalece a credibilidade da marca.',
    featured: true,
  },
  {
    icon: 'layers' as const,
    title: 'Sistemas Web',
    audience: 'Para processos internos',
    description:
      'Plataformas sob medida para gerenciar processos, dados e fluxos de trabalho específicos do seu negócio.',
    featured: true,
  },
  {
    icon: 'sliders' as const,
    title: 'Landing pages',
    audience: 'Para campanhas e conversão',
    description: 'Páginas focadas em apresentar uma oferta e converter visitantes em contato.',
    featured: false,
  },
  {
    icon: 'devices' as const,
    title: 'Apps personalizados',
    audience: 'Para produtos digitais próprios',
    description: 'Aplicações desenvolvidas sob medida para a necessidade específica do seu negócio.',
    featured: false,
  },
  {
    icon: 'puzzle' as const,
    title: 'Soluções sob medida',
    audience: 'Para integrações e automação',
    description: 'Integrações entre sistemas e automação de processos para digitalizar rotinas manuais.',
    featured: false,
  },
];
---

<section id="servicos" class="scroll-mt-20 border-t border-[var(--color-border)] py-20 sm:py-28" aria-label="Serviços">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="max-w-2xl">
      <span class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-brand-400)]">
        O que eu faço
      </span>
      <h2 class="mt-3 font-[var(--font-display)] text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Soluções digitais para cada etapa do seu negócio
      </h2>
      <p class="mt-4 text-base leading-relaxed text-[var(--color-ink-muted)]">
        Do site que apresenta sua empresa ao sistema que organiza a sua
        operação: cada projeto é desenvolvido para a necessidade específica
        do seu negócio.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <article
          class:list={[
            'group relative overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-7 transition-colors hover:border-[var(--color-brand-500)]/50',
            service.featured ? 'lg:col-span-2' : 'lg:col-span-1',
          ]}
        >
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-[var(--color-brand-500)]/12 text-[var(--color-brand-400)]">
            <Icon name={service.icon} class="h-5 w-5" />
          </div>
          <h3 class="mt-5 text-lg font-semibold text-white">{service.title}</h3>
          <p class="mt-1 text-xs font-medium uppercase tracking-wide text-[var(--color-ink-faint)]">
            {service.audience}
          </p>
          <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-muted)]">
            {service.description}
          </p>
        </article>
      ))}
    </div>

    <p class="mt-10 text-sm text-[var(--color-ink-muted)]">
      Precisa de algo diferente?
      <a
        href={buildWhatsAppLink()}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 font-semibold text-white transition-colors hover:text-[var(--color-brand-400)]"
      >
        Me conta sua ideia
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </p>
  </div>
</section>
