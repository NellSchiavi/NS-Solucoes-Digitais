---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import { CATEGORY_LABELS } from '../lib/categories';

const allProjects = await getCollection('projects', ({ data }) => data.visibility !== 'oculto');

allProjects.sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return a.data.order - b.data.order;
});

const activeCategories = new Set(allProjects.map((p) => p.data.category));
const filters = (Object.entries(CATEGORY_LABELS) as [string, string][]).filter(([slug]) =>
  activeCategories.has(slug as never),
);
---

<section id="portfolio" class="scroll-mt-20 border-t border-[var(--color-border)] py-20 sm:py-28" aria-label="Portfólio">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
      <div class="max-w-2xl">
        <span class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-brand-400)]">
          Portfólio
        </span>
        <h2 class="mt-3 font-[var(--font-display)] text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Projetos que saíram do papel
        </h2>
        <p class="mt-4 text-base leading-relaxed text-[var(--color-ink-muted)]">
          Projetos reais que desenvolvi para clientes — de sites
          institucionais a sistemas web sob medida. Abra cada case para ver
          as telas e o que foi entregue.
        </p>
      </div>
    </div>

    {filters.length > 1 && (
      <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filtrar por categoria" id="portfolio-filters">
        <button
          type="button"
          data-filter="all"
          class="filter-btn is-active rounded-full px-4 py-1.5 text-sm font-medium transition-colors"
        >
          Todos
        </button>
        {filters.map(([slug, label]) => (
          <button
            type="button"
            data-filter={slug}
            class="filter-btn rounded-full px-4 py-1.5 text-sm font-medium transition-colors"
          >
            {label}
          </button>
        ))}
      </div>
    )}

    {allProjects.length > 0 ? (
      <div id="portfolio-grid" class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {allProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    ) : (
      <p class="mt-10 text-[var(--color-ink-muted)]">Novos cases em breve.</p>
    )}
  </div>
</section>

<style>
  .filter-btn {
    color: var(--color-ink-muted);
    border: 1px solid var(--color-border-strong);
    background: transparent;
  }
  .filter-btn.is-active {
    color: var(--color-brand-ink);
    background: var(--color-brand-500);
    border-color: var(--color-brand-500);
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('#portfolio-filters .filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('#portfolio-grid [data-category]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      const filter = btn.dataset.filter;
      cards.forEach((card) => {
        const show = filter === 'all' || card.dataset.category === filter;
        card.classList.toggle('hidden', !show);
      });
    });
  });
</script>
