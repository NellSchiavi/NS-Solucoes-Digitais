---
import ProjectCard from './ProjectCard.astro';
import { CATEGORY_LABELS } from '../lib/categories';
import { getPortfolioProjects } from '../lib/projects';

const allProjects = await getPortfolioProjects();

const activeCategories = new Set(allProjects.map((p) => p.data.category));
const filters = (Object.entries(CATEGORY_LABELS) as [string, string][]).filter(([slug]) =>
  activeCategories.has(slug as never),
);
---

<section id="portfolio" class="scroll-mt-20 border-t border-[var(--color-border)] py-20 sm:py-28" aria-labelledby="portfolio-title">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
      <div class="max-w-2xl">
        <span class="ns-eyebrow">Projetos</span>
        <h2 id="portfolio-title" class="mt-3 font-[var(--font-display)] text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Projetos que saíram do papel
        </h2>
        <p class="mt-4 text-base leading-relaxed text-[var(--color-ink-muted)]">
          Projetos reais desenvolvidos pela NS, de sites institucionais a
          sistemas de gestão. Veja o que cada um resolve, acesse os sites
          publicados e experimente a demonstração quando disponível.
        </p>
      </div>
    </div>

    {filters.length > 1 && (
      <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filtrar por categoria" id="portfolio-filters">
        <button
          type="button"
          data-filter="all"
          aria-pressed="true"
          class="filter-btn is-active rounded-full px-4 py-1.5 text-sm font-medium transition-colors"
        >
          Todos
        </button>
        {filters.map(([slug, label]) => (
          <button
            type="button"
            data-filter={slug}
            aria-pressed="false"
            class="filter-btn rounded-full px-4 py-1.5 text-sm font-medium transition-colors"
          >
            {label}
          </button>
        ))}
      </div>
    )}

    {allProjects.length > 0 ? (
      <div id="portfolio-grid" class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
        {allProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    ) : (
      <p class="mt-10 text-[var(--color-ink-muted)]">Novos cases em breve.</p>
    )}
  </div>
</section>

<style>
  .filter-btn {
    color: var(--color-ink-muted);
    border: 1px solid var(--color-border-strong);
    background: transparent;
  }
  .filter-btn.is-active {
    color: var(--color-brand-ink);
    background: var(--color-brand-500);
    border-color: var(--color-brand-500);
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('#portfolio-filters .filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('#portfolio-grid [data-category]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => {
        b.classList.toggle('is-active', b === btn);
        b.setAttribute('aria-pressed', String(b === btn));
      });

      const filter = btn.dataset.filter;
      cards.forEach((card) => {
        const show = filter === 'all' || card.dataset.category === filter;
        card.classList.toggle('hidden', !show);
      });
    });
  });
</script>
