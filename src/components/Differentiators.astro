---
import Icon from './Icon.astro';

const items = [
  {
    icon: 'user' as const,
    title: 'Atendimento direto com o desenvolvedor',
    description: 'A conversa acontece com quem desenvolve o projeto, sem intermediários entre a sua necessidade e a solução.',
  },
  {
    icon: 'sliders' as const,
    title: 'Soluções personalizadas',
    description: 'Cada projeto é construído para a necessidade específica do negócio, não adaptado de um modelo pronto.',
  },
  {
    icon: 'layers' as const,
    title: 'Acompanhamento próximo do projeto',
    description: 'Do planejamento ao lançamento, com comunicação constante sobre o andamento de cada etapa.',
  },
  {
    icon: 'devices' as const,
    title: 'Design moderno e responsivo',
    description: 'Interfaces atuais, com boa experiência no celular, no tablet e no computador.',
  },
  {
    icon: 'shield' as const,
    title: 'Segurança e controle de acesso',
    description: 'Nos sistemas, autenticação, permissões por perfil e proteção dos dados fazem parte do desenvolvimento.',
  },
  {
    icon: 'puzzle' as const,
    title: 'Solução pensada para o negócio',
    description: 'O ponto de partida é entender o problema do cliente antes de definir a solução técnica.',
  },
];
---

<section id="diferenciais" class="scroll-mt-20 border-t border-[var(--color-border)] py-20 sm:py-28" aria-labelledby="diferenciais-title">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="max-w-2xl">
      <span class="ns-eyebrow">Diferenciais</span>
      <h2 id="diferenciais-title" class="mt-3 font-[var(--font-display)] text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Como a NS trabalha
      </h2>
    </div>

    <ul class="mt-12 grid grid-cols-1 gap-x-10 gap-y-8 lg:grid-cols-2">
      {items.map((item) => (
        <li class="flex gap-4 border-b border-[var(--color-border)] pb-8">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[var(--color-brand-500)]/12 text-[var(--color-brand-400)]">
            <Icon name={item.icon} class="h-5 w-5" />
          </div>
          <div>
            <h3 class="text-base font-semibold text-white">{item.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-[var(--color-ink-muted)]">
              {item.description}
            </p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
