---
import Icon from './Icon.astro';

const items = [
  {
    icon: 'check' as const,
    title: 'Atendimento personalizado',
    description: 'Comunicação direta comigo em todas as etapas do projeto, sem intermediários.',
  },
  {
    icon: 'sliders' as const,
    title: 'Desenvolvimento sob medida',
    description: 'Cada projeto é construído para a necessidade específica do negócio, não adaptado de um modelo pronto.',
  },
  {
    icon: 'devices' as const,
    title: 'Design moderno e responsivo',
    description: 'Interfaces atuais, com boa experiência em qualquer tamanho de tela.',
  },
  {
    icon: 'layers' as const,
    title: 'Acompanhamento em todas as etapas',
    description: 'Do planejamento ao lançamento, com comunicação constante sobre o andamento do projeto.',
  },
  {
    icon: 'puzzle' as const,
    title: 'Solução pensada para o negócio',
    description: 'O ponto de partida é entender o problema do cliente antes de definir a solução técnica.',
  },
];
---

<section id="diferenciais" class="scroll-mt-20 border-t border-[var(--color-border)] py-20 sm:py-28" aria-label="Diferenciais">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="max-w-2xl">
      <span class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-brand-400)]">
        Diferenciais
      </span>
      <h2 class="mt-3 font-[var(--font-display)] text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Como eu trabalho
      </h2>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-x-10 gap-y-8 lg:grid-cols-2">
      {items.map((item) => (
        <div class="flex gap-4 border-b border-[var(--color-border)] pb-8">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[var(--color-brand-500)]/12 text-[var(--color-brand-400)]">
            <Icon name={item.icon} class="h-5 w-5" />
          </div>
          <div>
            <h3 class="text-base font-semibold text-white">{item.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-[var(--color-ink-muted)]">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
