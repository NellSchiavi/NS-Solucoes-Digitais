---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { withBase } from '../lib/url';
import { SITE_NAME } from '../lib/seo';

interface Props {
  /** <title> e og:title — único por página. */
  title: string;
  /** meta description e og:description — única por página. */
  description: string;
  /** Imagem de compartilhamento (caminho em public/). Padrão: og-ns.png. */
  image?: { path: string; width: number; height: number; alt: string };
  /** 'website' na Home/Contato, 'article' nos cases. */
  type?: 'website' | 'article';
  /** Dados estruturados Schema.org (um objeto JSON-LD). */
  jsonLd?: Record<string, unknown>;
}

const DEFAULT_IMAGE = {
  path: '/og-ns.png',
  width: 1200,
  height: 630,
  alt: 'NS Soluções Digitais — Sua ideia em um site de verdade.',
};

const { title, description, image = DEFAULT_IMAGE, type = 'website', jsonLd } = Astro.props;

// URLs absolutas a partir de `site` + `base` do astro.config.mjs
// (hoje: https://nellschiavi.github.io/NS-Solucoes-Digitais/...).
// Astro.url.pathname já inclui o prefixo /NS-Solucoes-Digitais/.
const site = Astro.site!;
const canonicalURL = new URL(Astro.url.pathname, site).href;
const imageURL = new URL(withBase(image.path), site).href;

// JSON seguro dentro de <script>: impede que um "</script>" em algum texto
// encerre a tag antes da hora.
const jsonLdString = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="sitemap" type="application/xml" href={withBase('/sitemap-index.xml')} />
    <meta name="theme-color" content="#030504" />

    <!-- Open Graph (WhatsApp, LinkedIn, Facebook e afins) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:secure_url" content={imageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={image.alt} />

    {jsonLdString && <script type="application/ld+json" set:html={jsonLdString} />}

    <!-- Fontes servidas pelo próprio site, com preload (ver astro.config.mjs). -->
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-space-grotesk" preload />
  </head>
  <body>
    <slot />
  </body>
</html>
