---
/**
 * /contato — destino do QR Code do cartão de visita e materiais comerciais.
 *
 * Landing curta e mobile first: quem sou, o que faço, onde ver o trabalho
 * e como falar comigo. Sem o Header de navegação de propósito, para manter
 * o foco nos dois caminhos: portfólio e WhatsApp.
 * Textos reaproveitam a comunicação já aprovada na Home.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Footer from '../components/Footer.astro';
import { CATEGORY_LABELS } from '../lib/categories';
import { buildWhatsAppLink } from '../lib/whatsapp';
import { withBase } from '../lib/url';

const whatsAppLink = buildWhatsAppLink();
const homeLink = withBase('/');
const portfolioLink = withBase('/#portfolio');

// Mesma seleção e ordem do portfólio da Home.
const projects = await getCollection('projects', ({ data }) => data.visibility !== 'oculto');
projects.sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return a.data.order - b.data.order;
});

// Mesmos serviços da seção "O que eu faço" da Home.
const services = ['Sites institucionais', 'Landing pages', 'Sistemas Web', 'Apps personalizados'];
---

<BaseLayout
  title="Contato — NS | Nelson Schiavi Soluções Digitais"
  description="Nelson Schiavi desenvolve sites institucionais, landing pages, sistemas web e apps personalizados. Conheça os projetos ou fale direto pelo WhatsApp."
>
  <main class="relative overflow-hidden">
    <!-- Acentos de fundo — mesmos da Hero, discretos -->
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute inset-0 bg-[radial-gradient(700px_420px_at_50%_-5%,rgb(var(--brand-rgb)/0.07),transparent_65%)]"></div>
      <div class="absolute -right-16 top-16 h-32 w-32 -skew-x-12 border border-[var(--color-brand-500)]/15 sm:right-[10%] sm:h-40 sm:w-40"></div>
    </div>

    <!-- Apresentação + CTAs -->
    <section class="mx-auto flex max-w-2xl flex-col items-center px-5 pb-16 pt-10 text-center sm:px-8 sm:pb-20 sm:pt-16" aria-label="Apresentação">
      <Logo imgClass="h-12 w-auto object-contain sm:h-14" />

      <span class="mt-10 inline-flex items-center gap-2 rounded-full bg-[var(--color-surface)] px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-brand-400)] ring-1 ring-[var(--color-border-strong)]">
        Soluções digitais sob medida
      </span>

      <h1 class="mt-6 font-[var(--font-display)] text-4xl font-bold leading-[1.1] tracking-tight text-white sm:text-5xl">
        Olá, eu sou <span class="text-[var(--color-brand-400)]">Nelson Schiavi</span>.
      </h1>

      <p class="mt-5 text-lg leading-relaxed text-[var(--color-ink-muted)]">
        Desenvolvo sites institucionais, landing pages, sistemas web e apps
        personalizados para empresas e profissionais — do planejamento ao
        lançamento, com atendimento direto comigo.
      </p>

      <div class="mt-9 flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:justify-center">
        <Button href={homeLink} variant="primary" size="lg" icon="arrow-right" class="w-full sm:w-auto">
          Conhecer meus projetos
        </Button>
        <Button href={whatsAppLink} target="_blank" variant="secondary" size="lg" icon="whatsapp" class="w-full sm:w-auto">
          Falar comigo no WhatsApp
          <span class="sr-only">(abre em nova aba)</span>
        </Button>
      </div>

      <ul class="mt-10 flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm text-[var(--color-ink-muted)]" aria-label="Serviços">
        {services.map((service) => (
          <li class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-brand-500)]" aria-hidden="true"></span>
            {service}
          </li>
        ))}
      </ul>
    </section>

    <!-- Prévia do portfólio: projetos reais, com as capas já usadas nos cases -->
    {projects.length > 0 && (
      <section class="border-t border-[var(--color-border)] py-14 sm:py-20" aria-label="Projetos">
        <div class="mx-auto max-w-4xl px-5 sm:px-8">
          <div class="text-center">
            <span class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-brand-400)]">
              Portfólio
            </span>
            <h2 class="mt-3 font-[var(--font-display)] text-2xl font-bold tracking-tight text-white sm:text-3xl">
              Alguns projetos que desenvolvi
            </h2>
          </div>

          <ul class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-3 sm:gap-5">
            {projects.map((project) => (
              <li>
                <a
                  href={withBase(`/portfolio/${project.id}/`)}
                  class="group flex h-full items-center gap-4 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-3 transition-colors hover:border-[var(--color-brand-500)]/50 sm:flex-col sm:items-stretch sm:p-0 sm:overflow-hidden"
                >
                  <div class="aspect-[16/10] w-28 shrink-0 overflow-hidden rounded-lg bg-[var(--color-bg-soft)] sm:w-full sm:rounded-none">
                    {project.data.mainImage && (
                      <img
                        src={withBase(project.data.mainImage)}
                        alt=""
                        loading="lazy"
                        class="h-full w-full object-cover object-top"
                      />
                    )}
                  </div>
                  <div class="min-w-0 text-left sm:p-4">
                    {project.data.category && (
                      <span class="text-[0.68rem] font-semibold uppercase tracking-[0.1em] text-[var(--color-brand-400)]">
                        {CATEGORY_LABELS[project.data.category]}
                      </span>
                    )}
                    <p class="mt-1 text-sm font-semibold leading-snug text-white group-hover:text-[var(--color-brand-400)]">
                      {project.data.name}
                    </p>
                  </div>
                </a>
              </li>
            ))}
          </ul>

          <div class="mt-8 text-center">
            <a
              href={portfolioLink}
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-white transition-colors hover:text-[var(--color-brand-400)]"
            >
              Ver portfólio completo
              <Icon name="arrow-right" class="h-4 w-4" />
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- Fechamento — mesmo padrão visual do CTA final da Home -->
    <section class="border-t border-[var(--color-border)] py-14 sm:py-20" aria-label="Chamada para contato">
      <div class="mx-auto max-w-3xl px-5 sm:px-8">
        <div class="relative overflow-hidden rounded-3xl border border-[var(--color-border-strong)] bg-[var(--color-surface)] px-6 py-12 text-center sm:px-14 sm:py-16">
          <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(500px_260px_at_50%_0%,rgb(var(--brand-rgb)/0.10),transparent_70%)]" aria-hidden="true"></div>

          <h2 class="relative font-[var(--font-display)] text-2xl font-bold tracking-tight text-white sm:text-3xl">
            Sua ideia pode virar um produto digital de verdade.
          </h2>
          <p class="relative mx-auto mt-4 max-w-md text-base leading-relaxed text-[var(--color-ink-muted)]">
            Me conta o que você precisa e eu te retorno com os próximos passos.
          </p>

          <div class="relative mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
            <Button href={homeLink} variant="primary" size="lg" icon="arrow-right" class="w-full sm:w-auto">
              Conhecer meus projetos
            </Button>
            <Button href={whatsAppLink} target="_blank" variant="secondary" size="lg" icon="whatsapp" class="w-full sm:w-auto">
              Falar comigo no WhatsApp
              <span class="sr-only">(abre em nova aba)</span>
            </Button>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
