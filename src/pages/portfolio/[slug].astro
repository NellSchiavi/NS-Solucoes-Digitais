---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';
import { CATEGORY_LABELS } from '../../lib/categories';
import Icon from '../../components/Icon.astro';
import { buildWhatsAppLink } from '../../lib/whatsapp';
import { withBase } from '../../lib/url';
import { getPrimaryAction, getStatusLabel, getWhatsAppMessage } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.visibility !== 'oculto');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const gallery = data.additionalImages.map((image) =>
  typeof image === 'string'
    ? { src: withBase(image), caption: undefined }
    : { ...image, src: withBase(image.src) },
);

const primaryAction = getPrimaryAction(data);
const statusLabel = getStatusLabel(data);
const whatsAppLink = buildWhatsAppLink(getWhatsAppMessage(data));
const showDemoNotes = primaryAction?.kind === 'demo' && data.demoNotes.length > 0;
---

<BaseLayout
  title={`${data.name} — Case | NS Soluções Digitais`}
  description={data.shortDescription}
>
  <Header />
  <main>
    <!-- Hero do case -->
    <section class="relative border-b border-[var(--color-border)] py-16 sm:py-20">
      <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(900px_500px_at_10%_-10%,rgb(var(--brand-rgb)/0.10),transparent_60%)]"></div>
      <div class="mx-auto max-w-4xl px-5 sm:px-8">
        <a href={withBase('/#portfolio')} class="text-sm font-medium text-[var(--color-ink-muted)] hover:text-white">
          ← Voltar para o portfólio
        </a>

        <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2">
          {data.category && (
            <span class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-brand-400)]">
              {CATEGORY_LABELS[data.category]}
            </span>
          )}
          {statusLabel && (
            <span
              class:list={[
                'inline-flex items-center gap-1.5 rounded-full px-3 py-0.5 text-xs font-medium ring-1',
                primaryAction
                  ? 'text-[var(--color-brand-400)] ring-[var(--color-brand-500)]/40'
                  : 'text-[var(--color-ink-muted)] ring-[var(--color-border-strong)]',
              ]}
            >
              {primaryAction && <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-brand-500)]" aria-hidden="true"></span>}
              {statusLabel}
            </span>
          )}
        </div>
        <h1 class="mt-3 font-[var(--font-display)] text-3xl font-bold tracking-tight text-white sm:text-4xl">
          {data.name}
        </h1>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--color-ink-muted)]">
          {data.shortDescription}
        </p>

        {data.technologies.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-2">
            {data.technologies.map((tech) => (
              <span class="rounded-full border border-[var(--color-border-strong)] px-3 py-1 text-xs font-medium text-[var(--color-ink-muted)]">
                {tech}
              </span>
            ))}
          </div>
        )}

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          {primaryAction && (
            <Button href={primaryAction.href} target="_blank" variant="primary" size="lg" icon="arrow-right" class="w-full sm:w-auto">
              {primaryAction.label}
              <span class="sr-only">(abre em nova aba)</span>
            </Button>
          )}
          <Button
            href={whatsAppLink}
            target="_blank"
            variant={primaryAction ? 'secondary' : 'primary'}
            size="lg"
            icon="whatsapp"
            class="w-full sm:w-auto"
          >
            Solicitar orçamento
            <span class="sr-only">pelo WhatsApp (abre em nova aba)</span>
          </Button>
        </div>

        {showDemoNotes && (
          <aside
            class="mt-8 rounded-2xl border border-[var(--color-brand-500)]/30 bg-[var(--color-surface)] p-5 sm:p-6"
            aria-labelledby="demo-notes-title"
          >
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-[var(--color-brand-400)]">
              Ambiente de demonstração
            </p>
            <h2 id="demo-notes-title" class="mt-1.5 text-base font-semibold text-white">
              Como experimentar
            </h2>
            <ul class="mt-3 space-y-2">
              {data.demoNotes.map((note) => (
                <li class="flex gap-2.5 text-sm leading-relaxed text-[var(--color-ink-muted)]">
                  <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-[var(--color-brand-500)]" />
                  {note}
                </li>
              ))}
            </ul>
          </aside>
        )}
      </div>
    </section>

    <!-- Imagem principal / placeholder -->
    <section class="mx-auto max-w-4xl px-5 py-10 sm:px-8">
      {data.mainImage ? (
        <img
          src={withBase(data.mainImage)}
          alt={`Screenshot principal do projeto ${data.name}`}
          class="w-full rounded-2xl border border-[var(--color-border)]"
        />
      ) : (
        <div class="relative flex aspect-video items-center justify-center overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)]">
          <div class="absolute -right-10 -top-10 h-40 w-40 -skew-x-12 border border-[var(--color-brand-500)]/20"></div>
          <p class="relative px-6 text-center text-sm text-[var(--color-ink-faint)]">
            {primaryAction?.kind === 'demo'
              ? 'Veja a interface real na demonstração pública.'
              : 'Imagens do projeto disponíveis mediante solicitação.'}
          </p>
        </div>
      )}
    </section>

    <!-- Conteúdo do case (Markdown: contexto, solução, funcionalidades) -->
    <section class="mx-auto max-w-3xl px-5 pb-16 sm:px-8">
      {data.problem && (
        <div class="mb-4 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 sm:p-6">
          <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-brand-400)]">
            O que o projeto resolve
          </h2>
          <p class="mt-2 text-base leading-relaxed text-white">{data.problem}</p>
        </div>
      )}
      <div class="prose-case">
        <Content />
      </div>
    </section>

    <!-- Galeria de imagens adicionais — só aparece quando há screenshots -->
    {gallery.length > 0 && (
      <section class="mx-auto max-w-4xl px-5 pb-16 sm:px-8">
        <h2 class="mb-5 font-[var(--font-display)] text-xl font-bold text-white">Telas do projeto</h2>
        <div class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
          {gallery.map((image, index) => (
            <figure>
              <a
                href={image.src}
                target="_blank"
                rel="noopener noreferrer"
                class="block overflow-hidden rounded-xl border border-[var(--color-border)] transition-colors hover:border-[var(--color-brand-500)]/50"
                aria-label={`Abrir imagem ampliada: ${image.caption ?? `imagem ${index + 1}`}`}
              >
                <img
                  src={image.src}
                  alt={image.caption ? `${data.name} — ${image.caption}` : `${data.name} — imagem ${index + 1}`}
                  loading="lazy"
                  class="w-full"
                />
              </a>
              {image.caption && (
                <figcaption class="mt-2.5 text-sm text-[var(--color-ink-muted)]">{image.caption}</figcaption>
              )}
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- CTA final do case -->
    <section class="border-t border-[var(--color-border)] bg-[var(--color-bg-soft)] py-14">
      <div class="mx-auto max-w-3xl px-5 sm:px-8">
        <h2 class="font-[var(--font-display)] text-2xl font-bold tracking-tight text-white">
          Quer um projeto assim para o seu negócio?
        </h2>
        <p class="mt-3 max-w-xl text-base leading-relaxed text-[var(--color-ink-muted)]">
          Na NS, você conversa direto com o desenvolvedor responsável pelo
          projeto, do primeiro contato à entrega.
        </p>
        {!primaryAction && (
          <p class="mt-3 text-sm text-[var(--color-ink-faint)]">
            {data.mainImage
              ? 'Este projeto não possui acesso público. As telas desta página são capturas reais do sistema.'
              : 'Este projeto não possui acesso público.'}
          </p>
        )}

        <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <Button href={whatsAppLink} target="_blank" variant="primary" size="lg" icon="whatsapp" class="w-full sm:w-auto">
            Solicitar orçamento
            <span class="sr-only">pelo WhatsApp (abre em nova aba)</span>
          </Button>
          {primaryAction && (
            <Button href={primaryAction.href} target="_blank" variant="secondary" size="lg" icon="arrow-right" class="w-full sm:w-auto">
              {primaryAction.label}
              <span class="sr-only">(abre em nova aba)</span>
            </Button>
          )}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .prose-case :global(h2) {
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: white;
  }
  .prose-case :global(p) {
    margin-bottom: 1rem;
    line-height: 1.75;
    color: var(--color-ink-muted);
  }
  .prose-case :global(ul) {
    margin-bottom: 1rem;
    padding-left: 1.25rem;
    list-style: disc;
    color: var(--color-ink-muted);
  }
  .prose-case :global(li) {
    margin-bottom: 0.4rem;
    line-height: 1.6;
  }
  .prose-case :global(strong) {
    color: white;
    font-weight: 600;
  }
</style>
